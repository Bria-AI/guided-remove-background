build/
.DS_Store

# Benchmark results: every candidate/run output dir is ignored by default (raw
# per-case images, logs, etc. -- never committed). The three dated snapshots
# below are the exception: their curated JSON/README/csv files are tracked.
# `benchmark/results/*` (not `benchmark/results/`) is required for the `!`
# negations below to actually work -- a trailing-slash directory pattern on
# the parent blocks git from ever descending into it, even for new files
# under a later `!` line; `*` only matches each immediate child, which an
# exact-path `!` re-include can still override.
benchmark/results/*
!benchmark/results/may-2026
!benchmark/results/sep-2026
!benchmark/results/oct-2026

# Even inside a curated snapshot, never commit raw/normalized per-case images,
# per-run logs, or the large self-contained HTML export (share that file
# directly with whoever needs it instead).
benchmark/results/*/normalized/
benchmark/results/*/logs/
# Per-candidate raw-output directories (one PNG + preview JPG per case) -- same
# "metadata only" rule as normalized/ above. Named explicitly, like the rest of
# this file, rather than a broad glob: add the new candidate's directory name
# here whenever a benchmark run writes one.
benchmark/results/*/guided_v1_1/
benchmark/results/*/pairwise_run.out
benchmark/results/*/review_shareable.html
